# Operon Reservas — variables de entorno
# Copiar a .env.local y completar. Las NEXT_PUBLIC_* son seguras para el cliente.

NEXT_PUBLIC_SUPABASE_URL=https://guoxthaxwdsgwcsnvefq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Snu_1f4RBGFF99JSESj14w_3xlQ99Rp

# Solo servidor — NUNCA commitear el valor real. Pedírselo al admin del proyecto Supabase
# (Dashboard > Project Settings > API > service_role). Requerida para cobros con Mercado Pago
# (webhook + creación de preferencias con service_role).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Mercado Pago (Etapa 7) ----------
# Operon registra UNA aplicación de MP (marketplace); cada cabaña la autoriza vía OAuth.
# Crear en https://www.mercadopago.com.ar/developers/panel/app  → Credenciales de la app.
# Solo servidor — NUNCA exponer al cliente.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# URL pública del sitio: arma los links de reservas, invitaciones, el redirect del OAuth
# y el aviso de pago de MP. Un dominio *.vercel.app se ignora. En producción, si falta,
# se usa https://www.operonreservas.com. En local: http://localhost:3040
NEXT_PUBLIC_SITE_URL=https://www.operonreservas.com
# Opcional: override explícito del redirect. Debe coincidir EXACTO con el registrado en la app de MP.
# Si se omite, se usa ${NEXT_PUBLIC_SITE_URL}/api/mp/callback
MP_REDIRECT_URI=

# Edición mensual por zona (servidor; desactivada hasta configuración manual)
ZONE_MONTH_ENABLED=0
ZONE_CORDOBA_FEED_ZONES=
# Nunca usar prefijo NEXT_PUBLIC_ para estas claves. No poner claves reales aquí.
# Tu zona este mes (v2): Claude investiga el destino con búsqueda web. Solo servidor.
# Costo aproximado: US$0,20-0,40 por pueblo por mes con Sonnet 5.5.
ANTHROPIC_API_KEY=
# Opcional: otro modelo de Claude (por defecto claude-sonnet-5-5).
ZONE_MODEL=
CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY: usar la variable de servidor existente.
# Opcional: paquete JSON público curado que REEMPLAZA sources.json (máx. 64 KB).
ZONE_SOURCE_PACK_JSON=
# Hosts exactos adicionales de organismos turísticos confiables, separados por coma.
ZONE_SOURCE_HOSTS=

# Buscador de dirección con mapa (alta y Configuración, 0036). Clave de navegador de
# Google Cloud con Maps JavaScript API y Places API (New), restringida por dominio.
# Vacía: se usa el campo de texto de siempre.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
