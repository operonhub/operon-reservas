# Operon Reservas — variables de entorno
# Copiar a .env.local y completar. Las NEXT_PUBLIC_* son seguras para el cliente.

NEXT_PUBLIC_SUPABASE_URL=https://guoxthaxwdsgwcsnvefq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Snu_1f4RBGFF99JSESj14w_3xlQ99Rp

# Solo servidor — NUNCA commitear el valor real. Pedírselo al admin del proyecto Supabase
# (Dashboard > Project Settings > API > service_role). Requerida para cobros con Mercado Pago
# (webhook + creación de preferencias con service_role).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Mercado Pago (Etapa 7) ----------
# Operon registra UNA aplicación de MP (marketplace); cada cabaña la autoriza vía OAuth.
# Crear en https://www.mercadopago.com.ar/developers/panel/app  → Credenciales de la app.
# Solo servidor — NUNCA exponer al cliente.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# URL pública del sitio (para armar el redirect del OAuth). Ej: https://operon-reservas.vercel.app
NEXT_PUBLIC_SITE_URL=https://operon-reservas.vercel.app
# Opcional: override explícito del redirect. Debe coincidir EXACTO con el registrado en la app de MP.
# Si se omite, se usa ${NEXT_PUBLIC_SITE_URL}/api/mp/callback
MP_REDIRECT_URI=
